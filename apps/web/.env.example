# Copier vers .env.local et remplir avec les valeurs du projet Supabase
# (Project Settings > API sur le dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://ppnhcoikhuzyncwsusjt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optionnel — active la recherche de métadonnées via Spotify (developer.spotify.com)
# Sans ces variables, seule la source MusicBrainz (sans clé) est disponible.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Requis pour l'API Player (Phase 8+). Project Settings > API > JWT Settings
# (Legacy JWT secret) et Project Settings > API keys (secret key). Jamais
# exposées au client — utilisées uniquement dans app/api/player/*.
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=
